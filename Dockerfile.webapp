# syntax=docker/dockerfile:1.7

# ═══════════════════════════════════════════════════════════════════════════════
#  EC2-OPTIMISED MULTI-STAGE BUILD
#
#  Why it was slow (~22 min): QuantResearchAgent.csproj pulled in 35+ heavy
#  packages (AngleSharp, PdfPig, NAudio, SemanticKernel, ML frameworks, etc.)
#  and 228 source files. The WebApp Server references this project, forcing a
#  full recompile on each build.
#
#  Update (2026-10-15): the console CLI (Program.cs, InteractiveCLI.cs,
#  ApiTester.cs, Core/UIHelper.cs) is archived under Archive/Cli/ and excluded
#  from compilation, and its CLI-only / unused packages (Terminal.Gui,
#  Spectre.Console, NAudio, Microsoft.ML.OnnxRuntime) were dropped.
#  ~14,100 lines and ~200 MB less per publish; see Archive/Cli/README.md.
#
#  Fix: compile QuantResearchAgent ONCE as a separate Docker stage (cached).
#  The WebApp stage copies the pre-built artifacts and only compiles the
#  WebApp-specific files (~74 .cs).  As long as root-level sources don't
#  change, Docker reuses the cached QRA layer.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: restore (cached unless .csproj / NuGet.config change) ──────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS restore
WORKDIR /src
# Parallel compilation — 0 = use all available CPU cores
ENV DASHDOTNET_JOBS=0
COPY NuGet.config ./
COPY QuantResearchAgent.csproj ./
COPY WebApp/Core/Core.csproj WebApp/Core/
COPY WebApp/Client/Client.csproj WebApp/Client/
COPY WebApp/Server/Server.csproj WebApp/Server/
# Persistent NuGet package cache across builds.
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    dotnet restore WebApp/Server/Server.csproj

# ── Stage 2: build + publish everything ─────────────────────────────────
FROM restore AS build
# Copy all source code
COPY . .
# Quick build with parallel compilation on ALL cores.
# DASHDOTNET_JOBS=0 → auto-detect CPU count.
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    dotnet publish WebApp/Server/Server.csproj -c Release -o /app/publish \
        /p:UseAppHost=false /p:UseSharedCompilation=true

# ── Stage 3: runtime ────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# ---- INSTALL PYTHON & DEPENDENCIES (cached; only rebuilds if this line changes) ----
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    --mount=type=cache,target=/root/.npm,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ffmpeg \
    nodejs \
    npm \
    openvpn \
    iproute2 \
    curl \
    ca-certificates && \
    pip3 install --no-cache-dir --break-system-packages \
    "yt-dlp[default]" \
    yt-dlp-ejs \
    python-dotenv \
    fastembed \
    numpy \
    requests \
    yfinance \
    beautifulsoup4 \
    newspaper3k \
    lxml \
    youtube-transcript-api && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    npm install -g deno && \
    rm -rf /var/lib/apt/lists/*
# --------------------------------------------------------------

COPY --from=build /app/publish .
COPY appsettings.json ./appsettings.json
COPY Scripts/ ./Scripts/

RUN mkdir -p /app/uploads /app/logs
COPY entrypoint.sh /usr/local/bin/feenqr-entrypoint.sh
RUN chmod +x /usr/local/bin/feenqr-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/feenqr-entrypoint.sh"]


