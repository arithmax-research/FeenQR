<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="http_proxy.maxConnectionsPerServer" value="16" />
    <add key="http_proxy.request.timeout.milliseconds" value="180000" />
    <!-- Persistent global packages folder (cached in the Docker build). -->
    <add key="globalPackagesFolder" value="/root/.nuget/packages" />
    <add key="signatureValidationMode" value="accept" />
  </config>
  <!-- Faster, more reliable restores -->
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
